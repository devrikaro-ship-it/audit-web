exports[`pagina de raport, randata > renders the alternative recovery surface when the primary catalog read fails > report:catalog-unavailable 1`] = `
"root/div[0] data-public-oauth-surface="report:catalog-unavailable" data-provider-scope="adwords" data-permission-capability="broad" data-application-behavior="read-operations-only" data-mutation-behavior="none"
root/div[0]/div[0]
