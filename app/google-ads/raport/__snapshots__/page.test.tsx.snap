root/div[0]/main[0]/div[5]/div[1]/article[0]/div[1]/h3[0]
root/div[0]/main[0]/div[5]/div[1]/article[0]/div[1]/h3[0]/text "O campanie liciteaza fara nicio tinta"
root/div[0]/main[0]/div[5]/div[1]/article[0]/div[1]/p[0]
root/div[0]/main[0]/div[5]/div[1]/article[0]/div[1]/p[0]/text "Detaliu."
