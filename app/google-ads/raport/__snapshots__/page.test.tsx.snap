root/div[0]/main[0]/div[6]/div[1]/article[0]/div[1]/h3[0]/text "O campanie liciteaza fara nicio tinta de randament"
root/div[0]/main[0]/div[6]/div[1]/article[0]/div[1]/p[0]
root/div[0]/main[0]/div[6]/div[1]/article[0]/div[1]/p[0]/text "PMax — Catalog complet maximizeaza valoarea fara tROAS setat. Google nu stie sub ce prag nu merita sa liciteze, deci imparte bugetul si catre produse care nu se intorc."
