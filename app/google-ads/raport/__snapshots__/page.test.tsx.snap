root/div[0]/main[0]/div[7]/div[0]/p[1]/text "+127.750 RON"
root/div[0]/main[0]/div[7]/div[0]/p[2]
root/div[0]/main[0]/div[7]/div[0]/p[2]/text "Atat ar insemna in plus pe luna din reclame daca clicurile ajung cu 20% mai ieftine si conversia creste cu 20% — cele doua lucruri la care lucram efectiv. Nu e o promisiune: intra si misca tu ipoteza, pana la zero daca vrei."
