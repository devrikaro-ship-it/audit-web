root/div[0]/main[0]/div[7]/p[0]
root/div[0]/main[0]/div[7]/p[0]/text "Lasa-ne un contact si iti trimitem raportul complet, cu toate produsele pe nume si ordinea in care merita atacate. Fara obligatii."
root/div[0]/main[0]/div[7]/form[0]
root/div[0]/main[0]/div[8]
root/div[0]/main[0]/div[8]/h2[0]
root/div[0]/main[0]/div[8]/h2[0]/text "Ce nu am putut verifica"
root/div[0]/main[0]/div[8]/ul[0]
