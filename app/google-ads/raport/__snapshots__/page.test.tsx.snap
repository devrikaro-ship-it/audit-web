root/div[0]/main[0]/div[7]/div[0]/p[2]/text "Atat ar insemna in plus pe luna din reclame daca clicurile ajung cu 20% mai ieftine si conversia creste cu 20% — cele doua lucruri la care lucram efectiv. Nu e o promisiune: intra si misca tu ipoteza, pana la zero daca vrei."
root/div[0]/main[0]/div[7]/div[0]/a[0]
root/div[0]/main[0]/div[7]/div[0]/a[0]/text "Vezi calculul pe cifrele tale"
root/div[0]/main[0]/div[7]/div[0]/a[0]/svg[0] aria-hidden="true"
root/div[0]/main[0]/div[7]/div[0]/a[0]/svg[0]/path[0]
root/div[0]/main[0]/div[8]
root/div[0]/main[0]/div[8]/h2[0]
root/div[0]/main[0]/div[8]/h2[0]/text "Vrei sa iti aratam si cum se repara?"
root/div[0]/main[0]/div[8]/p[0]
root/div[0]/main[0]/div[8]/p[0]/text "Lasa-ne un contact si iti trimitem raportul complet, cu toate produsele pe nume si ordinea in care merita atacate. Fara obligatii."
root/div[0]/main[0]/div[8]/form[0]
root/div[0]/main[0]/div[9]
root/div[0]/main[0]/div[9]/h2[0]
root/div[0]/main[0]/div[9]/h2[0]/text "Ce nu am putut verifica"
root/div[0]/main[0]/div[9]/ul[0]
root/div[0]/main[0]/div[9]/ul[0]/li[0]
root/div[0]/main[0]/div[9]/ul[0]/li[0]/span[0] aria-hidden="true"
root/div[0]/main[0]/div[9]/ul[0]/li[0]/text "Marja pe produs — folosim valoarea data de tine, deci vorbim despre incasari, nu despre profit."
root/div[0]/main[0]/div[9]/ul[0]/li[1]
root/div[0]/main[0]/div[9]/ul[0]/li[1]/span[0] aria-hidden="true"
root/div[0]/main[0]/div[9]/ul[0]/li[1]/text "Daca folosesti deja un partener CSS — de confirmat in cont."
root/div[0]/main[0]/div[9]/p[0]
root/div[0]/main[0]/div[9]/p[0]/b[0]
root/div[0]/main[0]/div[9]/p[0]/b[0]/text "MASURAT"
root/div[0]/main[0]/div[9]/p[0]/text "= citit direct din contul tau."
root/div[0]/main[0]/div[9]/p[0]/b[1]
root/div[0]/main[0]/div[9]/p[0]/b[1]/text "ESTIMARE"
root/div[0]/main[0]/div[9]/p[0]/text "= cifra reala inmultita cu un reper de piata, marcata ca atare."
root/div[0]/main[0]/div[9]/p[0]/b[2]
root/div[0]/main[0]/div[9]/p[0]/b[2]/text "SIMULARE"
root/div[0]/main[0]/div[9]/p[0]/text "= o proiectie sub ipoteze scrise, plafon optimist si incasari, niciodata profit. Nu prezentam niciodata o estimare sau o simulare drept fapt.""
`;
