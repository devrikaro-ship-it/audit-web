root/div[0]/main[0]/div[6]/div[1]/article[2]/div[1]/div[0]/span[0]/text "costa bani"
root/div[0]/main[0]/div[6]/div[1]/article[2]/div[1]/div[0]/span[1]
root/div[0]/main[0]/div[6]/div[1]/article[2]/div[1]/div[0]/span[1]/text "28.800 RON buget afectat"
root/div[0]/main[0]/div[6]/div[1]/article[2]/div[1]/h3[0]
root/div[0]/main[0]/div[6]/div[1]/article[2]/div[1]/h3[0]/text "O campanie Performance Max cumpara traficul pe numele tau"
root/div[0]/main[0]/div[6]/div[1]/article[2]/div[1]/p[0]
root/div[0]/main[0]/div[6]/div[1]/article[2]/div[1]/p[0]/text "Oamenii care cauta direct numele magazinului tau te-ar gasi oricum, pe cel mai ieftin click din cont. Fara protectie de brand, Performance Max liciteaza si pe ei — cu bani care ar fi trebuit sa aduca clienti noi. In rapoarte pare ca merge excelent, pentru ca raporteaza vanzarile unor oameni care veneau oricum."
root/div[0]/main[0]/div[6]/div[1]/article[2]/div[1]/div[1]
root/div[0]/main[0]/div[6]/div[1]/article[2]/div[1]/div[1]/span[0]
