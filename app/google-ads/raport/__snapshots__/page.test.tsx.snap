exports[`pagina de raport, randata > renders the alternative recovery surface when the primary catalog read fails > report:catalog-unavailable 1`] = `
"root/div[0] data-public-oauth-surface="report:catalog-unavailable" data-provider-scope="adwords" data-permission-capability="broad" data-application-behavior="read-operations-only" data-mutation-behavior="none"
root/div[0]/div[0]
root/div[0]/div[0]/h1[0]
root/div[0]/div[0]/h1[0]/text "Nu am putut citi catalogul de Shopping"
root/div[0]/div[0]/p[0]
root/div[0]/div[0]/p[0]/text "Se intampla cand contul nu are inca produse in Shopping, cand accesul prin API tocmai a fost retras sau cand Google raspunde greu. Nu s-a modificat nimic in contul tau."
root/div[0]/div[0]/div[0]
root/div[0]/div[0]/div[0]/a[0]
root/div[0]/div[0]/div[0]/a[0]/text "Incearca din nou"
root/div[0]/div[0]/div[0]/a[1] href="mailto:hello@devrika.ro?subject=Audit%20Google%20Ads%20-%20raportul%20nu%20s-a%20generat"
root/div[0]/div[0]/div[0]/a[1]/text "Scrie-ne si il facem noi manual""
`;

