root/div[0]/main[0]/div[6]/div[1]/article[4]/div[1]/h3[0]/text "Campania de brand plateste clicuri care veneau oricum"
root/div[0]/main[0]/div[6]/div[1]/article[4]/div[1]/p[0]
root/div[0]/main[0]/div[6]/div[1]/article[4]/div[1]/p[0]/text "Search — Brand liciteaza pe numele magazinului, pe potrivire larga. O parte din clicurile platite sunt oameni care te cautau deja pe nume."
root/div[0]/main[0]/div[6]/div[1]/article[4]/div[1]/div[1]
root/div[0]/main[0]/div[6]/div[1]/article[4]/div[1]/div[1]/span[0]
root/div[0]/main[0]/div[6]/div[1]/article[4]/div[1]/div[1]/span[0]/text "Search — Brand"
