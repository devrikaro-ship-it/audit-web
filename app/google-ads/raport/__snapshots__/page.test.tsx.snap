root/div[0]/main[0]/div[3]/div[1]/article[4]/div[0]/h3[0]/text "Cat ar aduce acelasi buget, mutat pe produsele care vand"
root/div[0]/main[0]/div[3]/div[1]/article[4]/div[0]/p[0]
root/div[0]/main[0]/div[3]/div[1]/article[4]/div[0]/p[0]/text "+81.000 RON"
root/div[0]/main[0]/div[3]/div[1]/article[4]/div[0]/p[1]
root/div[0]/main[0]/div[3]/div[1]/article[4]/div[0]/p[1]/text "Produsele care chiar vand la tine se intorc de 6.10 ori si aduc acum 81.000 RON. Daca opresti produsele slabe si muti acei 14.850 RON catre ele — fara sa adaugi niciun leu in plus — ar putea ajunge la 162.000 RON. Am oprit calculul la dublarea incasarilor actuale, desi inmultirea seaca ar da mai mult: produsele bune au un volum limitat de cautari si nu absorb oricat buget la acelasi randament. E un plafon optimist, nu o promisiune: la buget mai mare randamentul scade de obicei. Si sunt incasari, nu profit — profitul depinde de marja ta."
