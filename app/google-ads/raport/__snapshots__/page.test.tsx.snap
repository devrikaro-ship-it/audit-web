root/div[0]/main[0]/div[4]/div[3]/div[2]/div[0]/span[2]/text "2 produse · 1.200 lei cheltuiti · 100 lei adusi"
root/div[0]/main[0]/div[4]/div[3]/div[2]/p[0]
root/div[0]/main[0]/div[4]/div[3]/div[2]/p[0]/text "Au avut trafic serios si tot nu se acopera. Aici se taie, iar banii pleaca spre primele doua grupe."
