root/div[0]/main[0]/div[7]/ul[0]/li[1]/span[0] aria-hidden="true"
root/div[0]/main[0]/div[7]/ul[0]/li[1]/text "Daca folosesti deja un partener CSS — de confirmat in cont."
root/div[0]/main[0]/div[7]/p[0]
root/div[0]/main[0]/div[7]/p[0]/b[0]
root/div[0]/main[0]/div[7]/p[0]/b[0]/text "MASURAT"
root/div[0]/main[0]/div[7]/p[0]/text "= citit direct din contul tau."
root/div[0]/main[0]/div[7]/p[0]/b[1]
root/div[0]/main[0]/div[7]/p[0]/b[1]/text "ESTIMARE"
root/div[0]/main[0]/div[7]/p[0]/text "= cifra reala inmultita cu un reper de piata, marcata ca atare."
root/div[0]/main[0]/div[7]/p[0]/b[2]
root/div[0]/main[0]/div[7]/p[0]/b[2]/text "SIMULARE"
root/div[0]/main[0]/div[7]/p[0]/text "= o proiectie sub ipoteze scrise, plafon optimist si incasari, niciodata profit. Nu prezentam niciodata o estimare sau o simulare drept fapt.""
`;

