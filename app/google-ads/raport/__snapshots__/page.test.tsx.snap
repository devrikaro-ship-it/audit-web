root/div[0]/main[0]/div[6]/div[1]/article[5]/div[1]/h3[0]/text "Nu poti vedea pe ce cautari se duc banii"
root/div[0]/main[0]/div[6]/div[1]/article[5]/div[1]/p[0]
root/div[0]/main[0]/div[6]/div[1]/article[5]/div[1]/p[0]/text "Contul nu are nicio campanie Shopping standard activa. Performance Max raporteaza categorii de cautari, dar nu si cat a costat fiecare — asa ca nu exista nicaieri raspunsul la &quot;pe ce cuvinte mi s-au dus banii&quot;. O campanie Shopping standard, chiar si mica, aduce inapoi datele astea si face vizibile scurgerile."
