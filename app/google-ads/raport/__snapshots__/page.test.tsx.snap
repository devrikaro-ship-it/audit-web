root/div[0]/main[0]/div[6]/div[1]/article[6]/div[1]/div[0]/span[0]/text "de reglat"
root/div[0]/main[0]/div[6]/div[1]/article[6]/div[1]/h3[0]
root/div[0]/main[0]/div[6]/div[1]/article[6]/div[1]/h3[0]/text "O campanie urmeaza sa fie mutata automat de Google pe alt mod de functionare"
root/div[0]/main[0]/div[6]/div[1]/article[6]/div[1]/p[0]
root/div[0]/main[0]/div[6]/div[1]/article[6]/div[1]/p[0]/text "Google muta in cursul lui 2026 campaniile dinamice si pe cele pe potrivire larga catre noul mod AI Max, in care alege singur pentru ce cautari si pe ce pagini se afiseaza. Pe un cont nepregatit — fara o lista solida de cuvinte blocate — asta inseamna ca incepe sa cumpere trafic pe care azi nu il cumpara, fara ca cineva sa fi decis asta."
