root/div[0]/main[0]/div[5]/div[1]/article[1]/div[1]/div[0]/span[0]/text "de reglat"
root/div[0]/main[0]/div[5]/div[1]/article[1]/div[1]/h3[0]
root/div[0]/main[0]/div[5]/div[1]/article[1]/div[1]/h3[0]/text "Nu poti vedea pe ce cautari se duc banii"
root/div[0]/main[0]/div[5]/div[1]/article[1]/div[1]/p[0]
root/div[0]/main[0]/div[5]/div[1]/article[1]/div[1]/p[0]/text "Contul nu are nicio campanie Shopping standard activa. Performance Max raporteaza categorii de cautari, dar nu si cat a costat fiecare — asa ca nu exista nicaieri raspunsul la &quot;pe ce cuvinte mi s-au dus banii&quot;. O campanie Shopping standard, chiar si mica, aduce inapoi datele astea si face vizibile scurgerile."
root/div[0]/main[0]/div[6] aria-hidden="true"
root/div[0]/main[0]/div[6]/div[0]
root/div[0]/main[0]/div[6]/div[0]/p[0]
root/div[0]/main[0]/div[6]/div[0]/p[0]/text "Simulare · cu Devrika, la acelasi buget"
root/div[0]/main[0]/div[6]/div[0]/p[1]
root/div[0]/main[0]/div[6]/div[0]/p[1]/text "+6.000 RON"
root/div[0]/main[0]/div[6]/div[0]/p[2]
root/div[0]/main[0]/div[6]/div[0]/p[2]/text "Atat ar insemna in plus pe luna din reclame daca clicurile ajung cu 20% mai ieftine si conversia creste cu 20% — cele doua lucruri la care lucram efectiv. Nu e o promisiune: intra si misca tu ipoteza, pana la zero daca vrei."
root/div[0]/main[0]/div[6]/div[0]/a[0]
root/div[0]/main[0]/div[6]/div[0]/a[0]/text "Vezi calculul pe cifrele tale"
