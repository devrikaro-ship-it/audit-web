`;

exports[`public Google Ads access boundary > renders the canonical contract on the privacy surface > privacy:normal 1`] = `
"root/link[0] href="/logo-devrika.png"
root/div[0] data-public-oauth-surface="privacy:normal" data-provider-scope="adwords" data-permission-capability="broad" data-application-behavior="read-operations-only" data-mutation-behavior="none"
root/div[0]/div[0]
root/div[0]/div[0]/a[0] href="/google-ads"
root/div[0]/div[0]/a[0]/img[0] alt="Devrika"
root/div[0]/div[0]/a[0]/span[0]
root/div[0]/div[0]/a[0]/span[0]/text "Devrika"
root/div[0]/div[0]/h1[0]
root/div[0]/div[0]/h1[0]/text "Privacy Policy"
root/div[0]/div[0]/p[0]
root/div[0]/div[0]/p[0]/text "The"
root/div[0]/div[0]/p[0]/b[0]
root/div[0]/div[0]/p[0]/b[0]/text "Audit Devrika"
root/div[0]/div[0]/p[0]/text "application — Google Ads account analysis. Last updated: August 2026."
root/div[0]/div[0]/p[1]
root/div[0]/div[0]/p[1]/text "This policy explains how the Audit Devrika application handles data you authorize it to access when you connect your Google Ads account. It uses plain language so you can understand what happens to your business data."
root/div[0]/div[0]/h2[0]
root/div[0]/div[0]/h2[0]/text "Who we are"
root/div[0]/div[0]/p[2]
root/div[0]/div[0]/p[2]/text "Devrika is a Romanian online marketing agency. The"
root/div[0]/div[0]/p[2]/b[0]
root/div[0]/div[0]/p[2]/b[0]/text "Audit Devrika"
root/div[0]/div[0]/p[2]/text "application described here runs on"
root/div[0]/div[0]/p[2]/b[1]
root/div[0]/div[0]/p[2]/b[1]/text "audit.devrika.io"
root/div[0]/div[0]/p[2]/text "and is operated by the same company. You can contact us at"
root/div[0]/div[0]/p[2]/a[0] href="mailto:hello@devrika.ro"
root/div[0]/div[0]/p[2]/a[0]/text "hello@devrika.ro"
root/div[0]/div[0]/p[2]/text "."
root/div[0]/div[0]/h2[1]
root/div[0]/div[0]/h2[1]/text "What data we read from your Google account"
root/div[0]/div[0]/p[3]
root/div[0]/div[0]/p[3]/text "With your explicit consent, the application requests one Google permission (adwords). The Google Ads OAuth permission is not read-only. The application reads the following data from your Google Ads account:"
root/div[0]/div[0]/ul[0]
root/div[0]/div[0]/ul[0]/li[0]
root/div[0]/div[0]/ul[0]/li[0]/span[0] aria-hidden="true"
root/div[0]/div[0]/ul[0]/li[0]/text "The app reads the data required for the audit: accessible Google Ads accounts, including their identifier, name, manager status, and currency, the selected account time zone, products and their Shopping performance, conversion tracking configuration, campaign structure, Performance Max campaigns, Shopping campaigns, Search campaigns, negative keywords, search terms, and account totals for the last 365 days."
root/div[0]/div[0]/ul[0]/li[1]
root/div[0]/div[0]/ul[0]/li[1]/span[0] aria-hidden="true"
root/div[0]/div[0]/ul[0]/li[1]/text "The application reads data, compares it with your business thresholds, and shows you the result immediately."
root/div[0]/div[0]/p[4]
root/div[0]/div[0]/p[4]/b[0]
root/div[0]/div[0]/p[4]/b[0]/text "We do not request or obtain access"
root/div[0]/div[0]/p[4]/text "to Gmail, Google Drive, contacts, calendars, or any other Google service. We cannot start or stop campaigns, change budgets, or spend money."
root/div[0]/div[0]/h2[2]
root/div[0]/div[0]/h2[2]/text "What we do with the data"
root/div[0]/div[0]/p[5]
root/div[0]/div[0]/p[5]/text "We use these categories to generate the report you see on screen. The analysis runs when you request it on the site."
root/div[0]/div[0]/p[6]
root/div[0]/div[0]/p[6]/text "Your Google authorization remains in a secure cookie for one hour and is not stored with the lead. If you request the PDF, we store your name, email, phone number, store website, selected account identity, confirmed financial inputs, calculated break-even values, the report PDF, and its delivery status. We use this record only to generate, deliver, and support the requested audit. If optional monthly report delivery becomes available and you request it separately, the same limited purpose applies. We do not use this agreement for newsletters or general promotional messages. You may request deletion at any time."
root/div[0]/div[0]/h2[3]
root/div[0]/div[0]/h2[3]/text "How we protect Google user data"
root/div[0]/div[0]/p[7]
root/div[0]/div[0]/p[7]/text "We use HTTPS to encrypt data in transit between your browser, our application, and Google. Your Google authorization is held in a signed session cookie that expires after one hour. In production, the cookie is sent only over HTTPS, cannot be read by page JavaScript, and uses SameSite protection to limit cross-site requests."
root/div[0]/div[0]/p[8]
root/div[0]/div[0]/p[8]/text "Google API requests and application secrets are handled on the server. We do not store your Google authorization token with your contact record. Pending reports are stored in private server directories, and report snapshot files have restricted filesystem permissions. We verify signed report snapshots before using them and check that saved reports belong to the portal link used to open them."
root/div[0]/div[0]/p[9]
root/div[0]/div[0]/p[9]/text "Access to Google user data is limited to providing and supporting the requested audit and report delivery, as described in this policy. You can revoke Google access or request deletion using the instructions below."
root/div[0]/div[0]/h2[4]
root/div[0]/div[0]/h2[4]/text "Compliance with Google policies"
root/div[0]/div[0]/p[10]
root/div[0]/div[0]/p[10]/text "Our use and transfer to any other application of information received from Google APIs complies with the"
root/div[0]/div[0]/p[10]/a[0] href="https://developers.google.com/terms/api-services-user-data-policy"
root/div[0]/div[0]/p[10]/a[0]/text "Google API Services User Data Policy"
root/div[0]/div[0]/p[10]/text ", including its"
root/div[0]/div[0]/p[10]/i[0]
root/div[0]/div[0]/p[10]/i[0]/text "Limited Use"
root/div[0]/div[0]/p[10]/text "requirements. We do not use the data for advertising, sell it, transfer it, or allow people to read it except where strictly necessary to operate the application or comply with law."
root/div[0]/div[0]/h2[5]
root/div[0]/div[0]/h2[5]/text "Who we share data with"
root/div[0]/div[0]/p[11]
root/div[0]/div[0]/p[11]/text "We do not sell, rent, or use this data for third-party advertising. When email delivery is configured, Resend processes the recipient address, message, and attached PDF solely to deliver the report. Infrastructure providers may process data only as required to operate the application."
root/div[0]/div[0]/h2[6]
root/div[0]/div[0]/h2[6]/text "How to revoke access"
root/div[0]/div[0]/p[12]
root/div[0]/div[0]/p[12]/text "You can revoke access at any time without contacting us. Open"
root/div[0]/div[0]/p[12]/a[0] href="https://myaccount.google.com/permissions"
root/div[0]/div[0]/p[12]/a[0]/text "myaccount.google.com/permissions"
root/div[0]/div[0]/p[12]/text ", find"
root/div[0]/div[0]/p[12]/b[0]
root/div[0]/div[0]/p[12]/b[0]/text "Audit Devrika"
root/div[0]/div[0]/p[12]/text "in the list, and select “Remove access.” The application can no longer read your account after access is removed."
root/div[0]/div[0]/h2[7]
root/div[0]/div[0]/h2[7]/text "Your rights"
root/div[0]/div[0]/p[13]
root/div[0]/div[0]/p[13]/text "Under the GDPR, you may request a copy of the personal data we hold about you, request its correction or deletion, and object to processing. Email"
root/div[0]/div[0]/p[13]/a[0] href="mailto:hello@devrika.ro"
root/div[0]/div[0]/p[13]/a[0]/text "hello@devrika.ro"
root/div[0]/div[0]/p[13]/text "; we will respond within 30 days."
root/div[0]/div[0]/h2[8]
root/div[0]/div[0]/h2[8]/text "Changes to this policy"
root/div[0]/div[0]/p[14]
root/div[0]/div[0]/p[14]/text "If we materially change how we handle data, we will update this page and the date shown above."
root/div[0]/div[0]/div[0]
root/div[0]/div[0]/div[0]/a[0] href="/google-ads"
root/div[0]/div[0]/div[0]/a[0]/text "← Back to the application"
root/div[0]/div[0]/div[0]/a[1] href="/termeni"
root/div[0]/div[0]/div[0]/a[1]/text "Terms and Conditions""
`;

exports[`public Google Ads access boundary > renders the canonical contract on the terms surface > terms:normal 1`] = `
"root/link[0] href="/logo-devrika.png"
root/div[0] data-public-oauth-surface="terms:normal" data-provider-scope="adwords" data-permission-capability="broad" data-application-behavior="read-operations-only" data-mutation-behavior="none"
root/div[0]/div[0]
root/div[0]/div[0]/a[0] href="/google-ads"
root/div[0]/div[0]/a[0]/img[0] alt="Devrika"
root/div[0]/div[0]/a[0]/span[0]
root/div[0]/div[0]/a[0]/span[0]/text "Devrika"
root/div[0]/div[0]/h1[0]
root/div[0]/div[0]/h1[0]/text "Terms and Conditions"
root/div[0]/div[0]/p[0]
root/div[0]/div[0]/p[0]/text "The"
root/div[0]/div[0]/p[0]/b[0]
root/div[0]/div[0]/p[0]/b[0]/text "Audit Devrika"
root/div[0]/div[0]/p[0]/text "application — Google Ads account analysis. Last updated: August 2026."
root/div[0]/div[0]/h2[0]
root/div[0]/div[0]/h2[0]/text "What this service is"
root/div[0]/div[0]/p[1]
root/div[0]/div[0]/p[1]/text "Audit Devrika analyzes your Google Ads account and shows where Shopping campaign money goes: which products spend budget without selling, which products have never been shown, and whether conversion tracking is configured correctly. The service is free and creates no obligation to purchase anything."
root/div[0]/div[0]/h2[1]
root/div[0]/div[0]/h2[1]/text "What we ask from you"
root/div[0]/div[0]/p[2]
root/div[0]/div[0]/p[2]/text "Authorize access to your Google Ads account through Google&#x27;s official authorization mechanism and provide an approximate profit margin so we can calculate the threshold below which a product loses money. We do not ask for passwords, payment-card details, or documents."
root/div[0]/div[0]/h2[2]
root/div[0]/div[0]/h2[2]/text "What we guarantee and what we do not"
root/div[0]/div[0]/p[3]
root/div[0]/div[0]/p[3]/text "Report figures read directly from your account are marked as measured. When we use a market benchmark instead of a measurement—for example, the typical cost-per-click difference between stores with and without a CSS partner—we label it"
root/div[0]/div[0]/p[3]/b[0]
root/div[0]/div[0]/p[3]/b[0]/text "ESTIMATE"
root/div[0]/div[0]/p[3]/text ". We never present an estimate as a measured fact."
root/div[0]/div[0]/p[4]
root/div[0]/div[0]/p[4]/text "The report is an analysis, not a guarantee of results. Decisions you make in your account remain yours, and Devrika is not responsible for their commercial effects. If conversion tracking is configured incorrectly, the report says so; performance figures cannot be judged reliably until tracking is repaired."
root/div[0]/div[0]/h2[3]
root/div[0]/div[0]/h2[3]/text "What we never do"
root/div[0]/div[0]/p[5]
root/div[0]/div[0]/p[5]/text "The application reads data, compares it with your business thresholds, and shows you the result immediately. We do not change anything in your account. You can revoke the access you grant at any time from your Google account settings."
root/div[0]/div[0]/h2[4]
root/div[0]/div[0]/h2[4]/text "Your data"
root/div[0]/div[0]/p[6]
root/div[0]/div[0]/p[6]/text "Our handling of your data is described in the"
root/div[0]/div[0]/p[6]/a[0] href="/confidentialitate"
root/div[0]/div[0]/p[6]/a[0]/text "Privacy Policy"
root/div[0]/div[0]/p[6]/text ". In short, we read only what is needed for the audit. If you request the PDF, we store the report, your contact details, the store and selected-account context, the confirmed financial inputs, and delivery status so the report can be delivered and supported."
root/div[0]/div[0]/h2[5]
root/div[0]/div[0]/h2[5]/text "Optional monthly campaign reports"
root/div[0]/div[0]/p[7]
root/div[0]/div[0]/p[7]/text "If optional monthly report delivery becomes available, it will require a separate request. The email address you provide for an audit is used to deliver and support that requested audit only. We do not enroll you automatically in monthly reports, newsletters, general promotional messages, or third-party advertising."
root/div[0]/div[0]/h2[6]
root/div[0]/div[0]/h2[6]/text "Availability"
root/div[0]/div[0]/p[8]
root/div[0]/div[0]/p[8]/text "This free service is provided “as is.” We may modify or discontinue it without prior notice."
root/div[0]/div[0]/h2[7]
root/div[0]/div[0]/h2[7]/text "Contact"
