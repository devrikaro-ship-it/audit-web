root/div[0]/div[0]/h2[0]/text "Ce este acest serviciu"
root/div[0]/div[0]/p[1]
root/div[0]/div[0]/p[1]/text "Audit Devrika este o aplicatie care analizeaza contul tau de Google Ads si iti arata unde se duc banii din campaniile de Shopping: ce produse consuma buget fara sa vanda, ce produse nu au fost afisate niciodata si daca masurarea conversiilor e configurata corect. Serviciul e oferit gratuit, fara obligatia de a cumpara ceva."
root/div[0]/div[0]/h2[1]
root/div[0]/div[0]/h2[1]/text "Ce iti cerem"
root/div[0]/div[0]/p[2]
root/div[0]/div[0]/p[2]/text "Sa ne dai acces la contul tau de Google Ads, prin mecanismul oficial de autorizare Google, si sa ne spui aproximativ ce marja de profit ai — din ea calculam pragul sub care un produs pierde bani. Nu iti cerem parole, date de card sau documente."
root/div[0]/div[0]/h2[2]
root/div[0]/div[0]/h2[2]/text "Ce garantam si ce nu"
root/div[0]/div[0]/p[3]
root/div[0]/div[0]/p[3]/text "Cifrele din raport sunt citite direct din contul tau si le marcam ca atare. Acolo unde folosim un reper de piata in loc de o masuratoare — de exemplu diferenta tipica de cost pe click intre magazinele cu si fara CSS — scrie explicit"
root/div[0]/div[0]/p[3]/b[0]
root/div[0]/div[0]/p[3]/b[0]/text "ESTIMARE"
root/div[0]/div[0]/p[3]/text ". Nu prezentam niciodata o estimare drept fapt masurat."
root/div[0]/div[0]/p[4]
root/div[0]/div[0]/p[4]/text "Raportul e o analiza, nu o garantie de rezultat. Deciziile pe care le iei in contul tau iti apartin, iar Devrika nu raspunde pentru efectele lor comerciale. Daca masurarea conversiilor din contul tau e configurata gresit, o spunem in raport — dar in acel caz cifrele de performanta nu pot fi judecate pana nu e reparata."
root/div[0]/div[0]/h2[3]
root/div[0]/div[0]/h2[3]/text "Ce nu facem niciodata"
root/div[0]/div[0]/p[5]
root/div[0]/div[0]/p[5]/text "Aplicatia citeste datele, le compara cu pragurile afacerii tale si iti arata rezultatul pe loc. Nu modificam nimic in contul tau. Accesul pe care ni-l dai il poti retrage oricand din setarile contului tau Google."
root/div[0]/div[0]/h2[4]
root/div[0]/div[0]/h2[4]/text "Datele tale"
root/div[0]/div[0]/p[6]
root/div[0]/div[0]/p[6]/text "Modul in care tratam datele e descris pe larg in"
root/div[0]/div[0]/p[6]/a[0] href="/confidentialitate"
root/div[0]/div[0]/p[6]/a[0]/text "politica de confidentialitate"
root/div[0]/div[0]/p[6]/text ". In short: we read only what is needed for the audit. If you request the PDF, we store the report, your contact details, the store and selected-account context, the confirmed financial inputs, and delivery status so the report can be delivered and supported."
root/div[0]/div[0]/h2[5]
root/div[0]/div[0]/h2[5]/text "Disponibilitate"
root/div[0]/div[0]/p[7]
root/div[0]/div[0]/p[7]/text "Fiind un serviciu gratuit, il oferim «asa cum este» si putem sa il oprim sau sa il modificam oricand, fara notificare prealabila."
root/div[0]/div[0]/h2[6]
root/div[0]/div[0]/h2[6]/text "Contact"
root/div[0]/div[0]/p[8]
root/div[0]/div[0]/p[8]/text "Pentru orice intrebare legata de acesti termeni:"
root/div[0]/div[0]/p[8]/a[0] href="mailto:hello@devrika.ro"
root/div[0]/div[0]/p[8]/a[0]/text "hello@devrika.ro"
root/div[0]/div[0]/p[8]/text "."
root/div[0]/div[0]/div[0]
root/div[0]/div[0]/div[0]/a[0] href="/google-ads"
root/div[0]/div[0]/div[0]/a[0]/text "← Inapoi la aplicatie"
root/div[0]/div[0]/div[0]/a[1] href="/confidentialitate"
root/div[0]/div[0]/div[0]/a[1]/text "Politica de confidentialitate""
`;
