root/div[0]/section[4]/div[0]/div[2]/p[0]
root/div[0]/section[4]/div[0]/div[2]/p[0]/text "Spui cat iti ramane din 100 de lei"
root/div[0]/section[4]/div[0]/div[2]/p[1]
root/div[0]/section[4]/div[0]/div[2]/p[1]/text "Un singur camp: marja ta, aproximativ. Din ea calculam noi pragul sub care un produs nu-si merita bugetul — nu trebuie sa stii ce inseamna ROAS."
root/div[0]/section[4]/div[0]/div[3]
root/div[0]/section[4]/div[0]/div[3]/div[0] aria-hidden="true"
root/div[0]/section[4]/div[0]/div[3]/div[0]/text "3"
root/div[0]/section[4]/div[0]/div[3]/p[0]
root/div[0]/section[4]/div[0]/div[3]/p[0]/text "Primesti raportul"
root/div[0]/section[4]/div[0]/div[3]/p[1]
root/div[0]/section[4]/div[0]/div[3]/p[1]/text "Pe loc, pe cifrele tale din ultimele 365 de zile. Fara asteptare si fara discutie de vanzare inainte."
root/div[0]/section[5]
root/div[0]/section[5]/p[0]
root/div[0]/section[5]/p[0]/text "Dupa curatare"
root/div[0]/section[5]/h2[0]
root/div[0]/section[5]/h2[0]/text "Cat ar aduce acelasi buget, curatat"
root/div[0]/section[5]/p[1]
root/div[0]/section[5]/p[1]/text "Raportul ia banii ramasi dupa ce tai produsele slabe si ii pune la randamentul produselor care chiar vand la tine. Asa arata:"
root/div[0]/section[5]/div[0]
root/div[0]/section[5]/div[0]/div[0]
