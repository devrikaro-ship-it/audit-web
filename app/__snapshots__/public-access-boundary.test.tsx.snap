exports[`public Google Ads access boundary > matches every emitted metadata object to an independent structural snapshot > metadata:hub 1`] = `
"description="A web application that analyzes your store and advertising accounts and shows where you are losing money: on your website, in Google Ads, and in Shopping campaigns."
title="Audit Devrika — free audits for online stores""
`;

exports[`public Google Ads access boundary > matches every emitted metadata object to an independent structural snapshot > metadata:landing 1`] = `
"description="Audit Devrika analyzes your Google Ads account over the last 365 days. The app reads the data required for the audit: accessible Google Ads accounts, including their identifier, name, manager status, and currency, the selected account time zone, products and their Shopping performance, conversion tracking configuration, campaign structure, Performance Max campaigns, Shopping campaigns, Search campaigns, negative keywords, search terms, and account totals for the last 365 days. We do not change anything in your account."
title="Free Google Ads audit — Devrika""
`;

exports[`public Google Ads access boundary > matches every emitted metadata object to an independent structural snapshot > metadata:margin 1`] = `"title="Your margin · Devrika Google Ads Audit""`;

exports[`public Google Ads access boundary > matches every emitted metadata object to an independent structural snapshot > metadata:privacy 1`] = `
"description="How the Devrika application handles your Google Ads account data: what we read, what we retain, who we do not share it with, and how you revoke access."
title="Privacy Policy — Audit Devrika""
`;

exports[`public Google Ads access boundary > matches every emitted metadata object to an independent structural snapshot > metadata:report 1`] = `"title="Your report · Devrika Google Ads Audit""`;

exports[`public Google Ads access boundary > matches every emitted metadata object to an independent structural snapshot > metadata:simulator 1`] = `"title="Ce ar insemna cu Devrika · Audit Google Ads Devrika""`;

