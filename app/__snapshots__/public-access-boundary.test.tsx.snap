root/div[0]/section[3]/div[0]/div[2]/p[0]/text "Cat platesti in plus pe click"
root/div[0]/section[3]/div[0]/div[2]/p[1]
root/div[0]/section[3]/div[0]/div[2]/p[1]/text "Daca rulezi Shopping direct prin Google, fara CSS, costul pe click poate fi cu pana la ~20% mai mare. Cheltuiala pe care o aplicam e reala, procentul e un reper de piata — asa il si marcam."
root/div[0]/section[4]
root/div[0]/section[4]/p[0]
root/div[0]/section[4]/p[0]/text "Cum functioneaza"
root/div[0]/section[4]/h2[0]
root/div[0]/section[4]/h2[0]/text "Sub un minut pana la raport"
root/div[0]/section[4]/p[1]
root/div[0]/section[4]/p[1]/text "Nu ai nevoie de cunostinte tehnice si nu trebuie sa exporti nimic din cont."
root/div[0]/section[4]/div[0]
