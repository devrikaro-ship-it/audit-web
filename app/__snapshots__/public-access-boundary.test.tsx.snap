root/div[0]/section[1]/div[0]/a[1]/p[0]
root/div[0]/section[1]/div[0]/a[1]/p[0]/text "Pornind doar de la adresa magazinului, iti aratam unde pierzi cumparatori: masurarea vanzarilor, vizibilitatea in Google, experienta de cumparare si felul in care arati in Google Shopping."
root/div[0]/section[1]/div[0]/a[1]/p[1]
root/div[0]/section[1]/div[0]/a[1]/p[1]/text "Nu cere acces la niciun cont — analizeaza doar ce e public pe site."
