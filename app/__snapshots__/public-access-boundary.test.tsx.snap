root/div[0]/section[2]/div[0]/div[1]/article[1]/div[1]/table[0]/tbody[0]/tr[2]/td[6]/text "11×"
root/div[0]/section[2]/div[0]/div[1]/article[1]/div[1]/table[0]/tbody[0]/tr[2]/td[7]
root/div[0]/section[2]/div[0]/div[1]/article[1]/div[1]/table[0]/tbody[0]/tr[2]/td[7]/span[0]
root/div[0]/section[2]/div[0]/div[1]/article[1]/div[1]/table[0]/tbody[0]/tr[2]/td[7]/span[0]/text "+2,508 RON"
