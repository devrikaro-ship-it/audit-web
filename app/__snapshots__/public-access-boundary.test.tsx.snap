root/div[0]/section[1]/div[0]/div[0]/div[0]/h3[0]
root/div[0]/section[1]/div[0]/div[0]/div[0]/h3[0]/text "Audit Meta Ads"
root/div[0]/section[1]/div[0]/div[0]/div[0]/span[0]
root/div[0]/section[1]/div[0]/div[0]/div[0]/span[0]/text "In pregatire"
root/div[0]/section[1]/div[0]/div[0]/p[0]
root/div[0]/section[1]/div[0]/div[0]/p[0]/text "Aceeasi analiza pentru campaniile de Facebook si Instagram: ce reclame consuma buget fara sa aduca vanzari si cat de credibile sunt cifrele raportate de platforma."
root/div[0]/section[1]/div[0]/div[0]/p[1]
root/div[0]/section[1]/div[0]/div[0]/p[1]/text "Se conecteaza la contul tau de reclame Meta."
