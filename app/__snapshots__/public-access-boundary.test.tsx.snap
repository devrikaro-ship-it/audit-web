root/div[0]/section[5]/div[0]/div[0]/div[2]/div[0]/span[0]
root/div[0]/section[5]/div[0]/div[0]/div[2]/div[0]/span[0]/text "Buget curatat, marit de 5 ori"
root/div[0]/section[5]/div[0]/div[0]/div[2]/div[0]/span[1]
root/div[0]/section[5]/div[0]/div[0]/div[2]/div[0]/span[1]/text "241.000 lei"
root/div[0]/section[5]/div[0]/div[0]/div[2]/div[1]
root/div[0]/section[5]/div[0]/div[0]/div[2]/div[1]/div[0]
root/div[0]/section[5]/div[0]/p[0]
root/div[0]/section[5]/div[0]/p[0]/text "Simulare, nu promisiune — un plafon optimist care presupune ca produsele bune tin acelasi randament la buget mai mare. E venit, nu profit: profitul depinde de marja ta, pe care ti-o cerem la pasul 2. Cifrele de mai sus sunt exemplu."
