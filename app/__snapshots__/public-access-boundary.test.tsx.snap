root/div[0]/section[4]/div[0]/div[1]/p[0]/text "Conectezi contul"
root/div[0]/section[4]/div[0]/div[1]/p[1]
root/div[0]/section[4]/div[0]/div[1]/p[1]/text "Te autentifici direct la Google, ca la orice aplicatie. Parola ta nu trece prin noi."
root/div[0]/section[4]/div[0]/div[2]
