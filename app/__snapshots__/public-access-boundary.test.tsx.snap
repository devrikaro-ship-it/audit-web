root/div[0]/section[3]/div[0]/div[1]/div[1]/details[0]/p[0]/b[0]/text "Audit Devrika"
root/div[0]/section[3]/div[0]/div[1]/div[1]/details[0]/p[0]/text "se conecteaza numai cu acordul tau. Aplicatia citeste datele necesare auditului: conturile Google Ads accesibile, inclusiv identificatorul, numele, statutul de manager si moneda, fusul orar al contului ales, produsele si performanta lor in Shopping, configurarea conversiilor, structura campaniilor, campaniile Performance Max, campaniile Shopping, campaniile Search, cuvintele cheie negative, termenii de cautare si totalurile contului din ultimele 365 de zile. Cerem un singur drept de acces, cel pentru Google Ads. Nimic din Gmail sau Drive. Nu stocam datele contului tau si nu facem nicio modificare in el."
root/div[0]/section[4]
root/div[0]/section[4]/div[0]
root/div[0]/section[4]/div[0]/div[0]
root/div[0]/section[4]/div[0]/div[0]/p[0]
root/div[0]/section[4]/div[0]/div[0]/p[0]/text "Raport gratuit"
root/div[0]/section[4]/div[0]/div[0]/h2[0]
root/div[0]/section[4]/div[0]/div[0]/h2[0]/text "Vezi ce produse trebuie limitate si in care merita sa investesti mai mult."
root/div[0]/section[4]/div[0]/div[0]/p[1]
root/div[0]/section[4]/div[0]/div[0]/p[1]/text "Pe datele tale reale. Fara card. Fara modificari in Google Ads."
root/div[0]/section[4]/div[0]/a[0] href="/google-ads/connect"
