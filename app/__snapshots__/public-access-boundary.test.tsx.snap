root/div[0]/section[2]/div[0]/p[0]
root/div[0]/section[2]/div[0]/p[0]/text "Cand un audit are nevoie de acces la un cont de publicitate, ti-l cerem prin mecanismul oficial al platformei."
root/div[0]/section[2]/div[0]/div[0]
root/div[0]/section[2]/div[0]/div[0]/div[0]
root/div[0]/section[2]/div[0]/div[0]/div[0]/p[0]
root/div[0]/section[2]/div[0]/div[0]/div[0]/p[0]/text "Citim doar ce e necesar"
root/div[0]/section[2]/div[0]/div[0]/div[0]/p[1]
root/div[0]/section[2]/div[0]/div[0]/div[0]/p[1]/text "Aplicatia citeste datele necesare auditului: conturile Google Ads accesibile, inclusiv identificatorul, numele, statutul de manager si moneda, fusul orar al contului ales, produsele si performanta lor in Shopping, configurarea conversiilor, structura campaniilor, campaniile Performance Max, campaniile Shopping, campaniile Search, cuvintele cheie negative, termenii de cautare si totalurile contului din ultimele 365 de zile. Nimic din Gmail, Drive sau alte servicii."
