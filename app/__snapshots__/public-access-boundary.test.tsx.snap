exports[`public Google Ads access boundary > renders the canonical contract on the privacy surface > privacy:normal 1`] = `
"root/link[0] href="/logo-devrika.png"
root/div[0] data-public-oauth-surface="privacy:normal" data-provider-scope="adwords" data-permission-capability="broad" data-application-behavior="read-operations-only" data-mutation-behavior="none"
root/div[0]/div[0]
root/div[0]/div[0]/a[0] href="/google-ads"
root/div[0]/div[0]/a[0]/img[0] alt="Devrika"
root/div[0]/div[0]/a[0]/span[0]
root/div[0]/div[0]/a[0]/span[0]/text "Devrika"
root/div[0]/div[0]/h1[0]
root/div[0]/div[0]/h1[0]/text "Politica de confidentialitate"
root/div[0]/div[0]/p[0]
root/div[0]/div[0]/p[0]/text "Aplicatia"
root/div[0]/div[0]/p[0]/b[0]
root/div[0]/div[0]/p[0]/b[0]/text "Audit Devrika"
root/div[0]/div[0]/p[0]/text "— analiza contului de Google Ads. Ultima actualizare: august 2026."
root/div[0]/div[0]/p[1]
root/div[0]/div[0]/p[1]/text "Aceasta politica descrie cum aplicatia Audit Devrika trateaza datele la care ii dai acces atunci cand iti conectezi contul de Google Ads. E scrisa in limbaj obisnuit, pentru ca ai dreptul sa intelegi ce se intampla cu datele afacerii tale."
root/div[0]/div[0]/h2[0]
root/div[0]/div[0]/h2[0]/text "Cine suntem"
root/div[0]/div[0]/p[2]
root/div[0]/div[0]/p[2]/text "Devrika este o agentie de marketing online din Romania. Aplicatia"
root/div[0]/div[0]/p[2]/b[0]
root/div[0]/div[0]/p[2]/b[0]/text "Audit Devrika"
root/div[0]/div[0]/p[2]/text "descrisa aici ruleaza pe"
root/div[0]/div[0]/p[2]/b[1]
root/div[0]/div[0]/p[2]/b[1]/text "audit.devrika.ro"
root/div[0]/div[0]/p[2]/text "si apartine aceleiasi firme. Ne poti scrie oricand la"
root/div[0]/div[0]/p[2]/a[0] href="mailto:hello@devrika.ro"
root/div[0]/div[0]/p[2]/a[0]/text "hello@devrika.ro"
root/div[0]/div[0]/p[2]/text "."
root/div[0]/div[0]/h2[1]
root/div[0]/div[0]/h2[1]/text "Ce date citim din contul tau Google"
root/div[0]/div[0]/p[3]
root/div[0]/div[0]/p[3]/text "Cu acordul tau explicit, aplicatia cere o singura permisiune Google (adwords). Permisiunea OAuth Google Ads nu este exclusiv de citire.Aplicatia citeste urmatoarele date din contul tau de Google Ads:"
root/div[0]/div[0]/ul[0]
root/div[0]/div[0]/ul[0]/li[0]
root/div[0]/div[0]/ul[0]/li[0]/span[0] aria-hidden="true"
root/div[0]/div[0]/ul[0]/li[0]/text "Aplicatia citeste datele necesare auditului: conturile Google Ads accesibile, inclusiv identificatorul, numele, statutul de manager si moneda, fusul orar al contului ales, produsele si performanta lor in Shopping, configurarea conversiilor, structura campaniilor, campaniile Performance Max, campaniile Shopping, campaniile Search, cuvintele cheie negative, termenii de cautare si totalurile contului din ultimele 365 de zile."
root/div[0]/div[0]/ul[0]/li[1]
root/div[0]/div[0]/ul[0]/li[1]/span[0] aria-hidden="true"
root/div[0]/div[0]/ul[0]/li[1]/text "Aplicatia citeste datele, le compara cu pragurile afacerii tale si iti arata rezultatul pe loc."
root/div[0]/div[0]/p[4]
root/div[0]/div[0]/p[4]/b[0]
root/div[0]/div[0]/p[4]/b[0]/text "Nu cerem si nu obtinem acces"
root/div[0]/div[0]/p[4]/text "la Gmail, Google Drive, contacte, calendar sau orice alt serviciu Google. Nu putem face nicio modificare in contul tau de Google Ads: nu putem porni sau opri campanii, nu putem schimba bugete si nu putem cheltui bani."
root/div[0]/div[0]/h2[2]
root/div[0]/div[0]/h2[2]/text "Ce facem cu ele"
root/div[0]/div[0]/p[5]
root/div[0]/div[0]/p[5]/text "Le folosim intr-un singur scop: sa generam raportul pe care il vezi pe ecran, folosind categoriile de date enumerate mai sus. Analiza se face in momentul in care esti pe site."
root/div[0]/div[0]/p[6]
root/div[0]/div[0]/p[6]/text "Your Google authorization remains in a secure cookie for one hour and is not stored with the lead. If you request the PDF, we store your name, email, phone number, store website, selected account identity, confirmed financial inputs, calculated break-even values, the report PDF, and its delivery status. We use this record only to generate, deliver, and support the requested audit. You may request its deletion at any time."
root/div[0]/div[0]/h2[3]
root/div[0]/div[0]/h2[3]/text "Conformarea cu politicile Google"
root/div[0]/div[0]/p[7]
root/div[0]/div[0]/p[7]/text "Folosirea si transferul catre orice alta aplicatie a informatiilor primite de la Google API-uri respecta"
root/div[0]/div[0]/p[7]/a[0] href="https://developers.google.com/terms/api-services-user-data-policy"
root/div[0]/div[0]/p[7]/a[0]/text "Google API Services User Data Policy"
root/div[0]/div[0]/p[7]/text ", inclusiv cerintele privind"
root/div[0]/div[0]/p[7]/i[0]
root/div[0]/div[0]/p[7]/i[0]/text "Limited Use"
root/div[0]/div[0]/p[7]/text ". Concret: nu folosim datele pentru publicitate, nu le vindem, nu le transferam si nu permitem oamenilor sa le citeasca, in afara cazurilor strict necesare pentru operarea aplicatiei sau impuse de lege."
root/div[0]/div[0]/h2[4]
root/div[0]/div[0]/h2[4]/text "Cu cine le impartim"
root/div[0]/div[0]/p[8]
root/div[0]/div[0]/p[8]/text "We do not sell, rent, or use this data for third-party advertising. When email delivery is configured, Resend processes the recipient address, message, and attached PDF solely to deliver the report. Infrastructure providers may process data only as required to operate the application."
root/div[0]/div[0]/h2[5]
root/div[0]/div[0]/h2[5]/text "Cum retragi accesul"
root/div[0]/div[0]/p[9]
root/div[0]/div[0]/p[9]/text "Oricand, dintr-un singur loc si fara sa ne intrebi pe noi: intra la"
root/div[0]/div[0]/p[9]/a[0] href="https://myaccount.google.com/permissions"
root/div[0]/div[0]/p[9]/a[0]/text "myaccount.google.com/permissions"
root/div[0]/div[0]/p[9]/text ", gaseste"
root/div[0]/div[0]/p[9]/b[0]
root/div[0]/div[0]/p[9]/b[0]/text "Audit Devrika"
root/div[0]/div[0]/p[9]/text "in lista si apasa «Remove access». Din acel moment aplicatia nu mai poate citi nimic din contul tau."
root/div[0]/div[0]/h2[6]
root/div[0]/div[0]/h2[6]/text "Drepturile tale"
root/div[0]/div[0]/p[10]
root/div[0]/div[0]/p[10]/text "Conform GDPR, ai dreptul sa ceri o copie a datelor pe care le detinem despre tine, rectificarea sau stergerea lor, si sa te opui prelucrarii. Scrie-ne la"
root/div[0]/div[0]/p[10]/a[0] href="mailto:hello@devrika.ro"
root/div[0]/div[0]/p[10]/a[0]/text "hello@devrika.ro"
root/div[0]/div[0]/p[10]/text "si raspundem in cel mult 30 de zile."
root/div[0]/div[0]/h2[7]
root/div[0]/div[0]/h2[7]/text "Modificari"
root/div[0]/div[0]/p[11]
root/div[0]/div[0]/p[11]/text "Daca schimbam ceva important in modul in care tratam datele, actualizam aceasta pagina si data de la inceputul ei."
root/div[0]/div[0]/div[0]
root/div[0]/div[0]/div[0]/a[0] href="/google-ads"
root/div[0]/div[0]/div[0]/a[0]/text "← Inapoi la aplicatie"
root/div[0]/div[0]/div[0]/a[1] href="/termeni"
root/div[0]/div[0]/div[0]/a[1]/text "Termeni si conditii""
`;

