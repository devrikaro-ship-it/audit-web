{
  "schema_version": 1,
  "checks": {
    "portal_route": {
      "profile": "targeted_tests",
      "command": [
        "npx",
        "vitest",
        "run",
        "app/google-ads/portal/[token]/page.test.tsx",
        "--reporter=verbose"
      ],
      "cwd": ".",
      "estimated_minutes": 3
    },
    "direct_portal_witness": {
      "profile": "targeted_tests",
      "command": [
        "node",
        ".superpowers/sdd/2026-09-08-reporting-only/portal/direct-portal-witness.cjs"
      ],
      "cwd": ".",
      "estimated_minutes": 5
    }
  },
  "rules": [
    {
      "id": "portal_route_behavior",
      "patterns": [
        "app/google-ads/portal/**"
      ],
      "statuses": [
        "A",
        "M"
      ],
      "category": "runtime",
      "risk": "fast",
      "checks": [
        "portal_route",
        "direct_portal_witness"
      ]
    },
    {
      "id": "portal_handoff_artifacts",
      "patterns": [
        ".superpowers/sdd/2026-09-08-reporting-only/portal/**"
      ],
      "statuses": [
        "A",
        "M"
      ],
      "category": "documentation",
      "risk": "fast",
      "checks": [],
      "allow_no_checks": true
    }
  ]
}
